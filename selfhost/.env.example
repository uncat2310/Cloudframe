# ---- Required -------------------------------------------------------------

# Password for signing in to the panel. It guards your bucket: make it long.
S3IP_PASSWORD=

# Cloudflare dashboard -> R2 -> Overview: "Account ID"
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Create API token ("Object Read & Write",
# limited to your bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bucket -> Settings -> Public access: the r2.dev URL or your custom domain,
# e.g. https://img.example.com
R2_PUBLIC_URL=

# ---- Optional -------------------------------------------------------------

# Only show objects under this prefix in the gallery, e.g. i/
# R2_INCLUDE_PATH=
# Default upload key template for new browsers
# S3IP_KEY_TEMPLATE=i/{{year}}/{{month}}/{{day}}/{{ulid-dayslice}}.{{ext}}
# Override the S3 endpoint, e.g. EU jurisdiction buckets:
# https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Secret used to sign login sessions (defaults to R2_SECRET_ACCESS_KEY)
# S3IP_SESSION_SECRET=
# Port the server listens on inside the container
# PORT=3000
