# Redis Configuration for Profile Sync
# Required for the E2E encrypted profile sync feature
# Format: redis://[username][:password]@host:port[/db]

# Local Redis instance
REDIS_URL=redis://localhost:6379

# Or using Redis Cloud / hosted service
# REDIS_URL=redis://username:password@your-redis-host.com:6379

# Preset profile (optional, for self-hosted personal deployments)
# When S3IP_PRESET_PASSWORD and valid S3 settings below are set, a browser
# without S3 settings can load them by entering just the access password.
# The password protects your S3 secret key: use a strong one.
# S3IP_PRESET_PASSWORD=change-me
# S3IP_PRESET_PROFILE_NAME=Preset
# S3IP_PRESET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3IP_PRESET_BUCKET=my-bucket
# S3IP_PRESET_REGION=auto
# S3IP_PRESET_ACCESS_KEY_ID=
# S3IP_PRESET_SECRET_ACCESS_KEY=
# S3IP_PRESET_PUBLIC_URL=https://img.example.com
# S3IP_PRESET_FORCE_PATH_STYLE=false
# S3IP_PRESET_INCLUDE_PATH=
# S3IP_PRESET_KEY_TEMPLATE=
