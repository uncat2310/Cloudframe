// Cloudflare Workers deployment for the self-hosted R2 mode.
// See selfhost/README.md. `pnpm build:worker` merges this file into the
// generated .output/server/wrangler.json, which is what gets deployed.
{
  "name": "s3-image-port",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Keep variables added in the Cloudflare dashboard across deploys.
  "keep_vars": true,
  "r2_buckets": [
    {
      // Must stay "BUCKET": the app looks the binding up by this name.
      "binding": "BUCKET",
      // TODO: your R2 bucket name
      "bucket_name": "img",
    },
  ],
  "vars": {
    // TODO: the bucket's public URL (custom domain or r2.dev address)
    "R2_PUBLIC_URL": "https://i.as4837.de",
  },
  // The login password is a secret, never put it here:
  //   npx wrangler@4 secret put S3IP_PASSWORD -c .output/server/wrangler.json
  // or Dashboard -> Workers -> s3-image-port -> Settings -> Variables and Secrets.
}
