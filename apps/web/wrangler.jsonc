// Cloudflare Workers deployment for the self-hosted R2 mode.
// See selfhost/README.md. `pnpm build:worker` merges this file into the
// generated .output/server/wrangler.json, which is what gets deployed.
// Nitro parses this as JSON with comments: no trailing commas.
{
  "name": "cloudframe",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The panel is served from a custom domain (pic.example.com), whose WAF
  // rate-limits logins; the *.workers.dev address would bypass that rule.
  // Set to true if you deploy without a custom domain.
  "workers_dev": false,
  // Branch previews would share the production bucket and password.
  "preview_urls": false,
  // Page loads get the static SPA shell (index.html) straight from Workers
  // static assets, which is free and doesn't count as a Worker request; only
  // /api calls run the Worker. Nitro adds the binding and directory.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables added in the Cloudflare dashboard across deploys.
  "keep_vars": true,
  "r2_buckets": [
    {
      // Must stay "BUCKET": the app looks the binding up by this name.
      "binding": "BUCKET",
      // TODO: your R2 bucket name
      "bucket_name": "img"
    }
  ],
  // Upload and gallery settings shared by every signed-in browser
  // (the "cloudframe-settings" namespace). Remove to keep them per browser.
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "6b368dfe455e4298aa060cbe1fc7052f"
    }
  ],
  // Login attempts per client IP, shared across Worker instances.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // TODO: the bucket's public URL (custom domain or r2.dev address)
    "R2_PUBLIC_URL": "https://i.example.com",
    // Shown on the storage settings page; keep in sync with bucket_name.
    "R2_BUCKET": "img",
    // Gallery thumbnails through Cloudflare Image Transformations, which must
    // be enabled for the zone of R2_PUBLIC_URL. Use "off" to show originals.
    "CLOUDFRAME_THUMBNAILS": "cloudflare"
  }
  // The login password is a secret, never put it here:
  //   npx wrangler@4 secret put CLOUDFRAME_PASSWORD -c .output/server/wrangler.json
  // or Dashboard -> Workers -> cloudframe -> Settings -> Variables and Secrets.
}
